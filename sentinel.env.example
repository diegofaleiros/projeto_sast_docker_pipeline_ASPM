# Auditoria recorrente: copie para sentinel.env e preencha os valores reais.
RUN_PIPELINE=false
GITLAB_URL=https://gitlab.exemplo.interno
GITLAB_API_TOKEN=SUBSTITUIR
GITLAB_VERIFY_TLS=true
GITLAB_PROJECTS=grupo/projeto
GITLAB_BRANCHES=main
GITLAB_MEMBERSHIP_ONLY=false
ASPM_BASE_URL=https://191.252.227.92
ASPM_PAT=aspm_pat_SUBSTITUIR
ASPM_WORKSPACE=slug-da-empresa
ASPM_BUSINESS_PRODUCT=slug-do-produto
ASPM_SCAN_COMPLETE=false
ASPM_POLL_TIMEOUT=900
SLACK_WEBHOOK_URL=
SLACK_SEVERITIES=CRITICAL,HIGH
SLACK_MAX_FINDINGS=10
SCAN_SCOPE=changed
FIRST_RUN_LOOKBACK_DAYS=7
BASELINE_ON_FIRST_RUN=true
BASELINE_COMMITS=1
HISTORY_FALLBACK=true
MAX_PROJECTS=2000
MAX_PUSHES=50
SEMGREP_CONFIGS=p/default p/owasp-top-ten p/secrets
SEMGREP_TIMEOUT=120
BEARER_SCANNERS=sast,secrets
TRIVY_ENABLED=true
TRIVY_SCANNERS=misconfig
TRIVY_TIMEOUT=600
STATE_DIR=/app/.state-aspm
REPORT_DIR=/app/relatorios
REPORT_XLSX=true
DRY_RUN=false
