# Lista de referência: cadastrar no grupo GitLab em Settings > CI/CD > Variables.
# Tipo Variable. Não carregar este arquivo no job; GitLab injeta as variáveis.
RUN_PIPELINE=true
ASPM_BASE_URL=https://191.252.227.92
ASPM_PAT=aspm_pat_SUBSTITUIR_PELO_PAT_DE_SERVICO
ASPM_WORKSPACE=slug-da-empresa
ASPM_BUSINESS_PRODUCT=slug-do-produto
ASPM_SCAN_COMPLETE=false
ASPM_POLL_TIMEOUT=900
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SUBSTITUIR
SLACK_SEVERITIES=CRITICAL,HIGH
SLACK_MAX_FINDINGS=10
PIPELINE_BLOCK_SEVERITIES=HIGH,CRITICAL
PIPELINE_FAIL_ON_SCAN_ERROR=true
PIPELINE_FAIL_ON_NOTIFICATION_ERROR=true
SEMGREP_CONFIGS=p/default p/owasp-top-ten p/secrets
BEARER_SCANNERS=sast,secrets
TRIVY_ENABLED=true
TRIVY_SCANNERS=misconfig
TRIVY_TIMEOUT=600
# CI_PROJECT_PATH, CI_COMMIT_SHA, CI_PROJECT_DIR e CI_SERVER_HOST vêm do GitLab.
# Para CA corporativa: REQUESTS_CA_BUNDLE com caminho do certificado PEM montado.
